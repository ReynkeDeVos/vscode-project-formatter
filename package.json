{
  "name": "project-formatter",
  "displayName": "Project Formatter",
  "description": "Use your project's formatter in VS Code. Fall back to Oxfmt.",
  "publisher": "kawa",
  "version": "0.1.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ReynkeDeVos/vscode-project-formatter.git"
  },
  "bugs": { "url": "https://github.com/ReynkeDeVos/vscode-project-formatter/issues" },
  "homepage": "https://github.com/ReynkeDeVos/vscode-project-formatter#readme",
  "engines": { "vscode": "^1.93.0" },
  "categories": ["Formatters"],
  "main": "./extension.cjs",
  "activationEvents": ["onStartupFinished"],
  "capabilities": { "untrustedWorkspaces": { "supported": false } },
